# Copy to .env.local (never commit it) and fill in from https://develop.battle.net
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us
# Optional: how long the leaderboard is cached, in seconds (default 300)
CACHE_TTL_SECONDS=300

# Optional: an Upstash Redis database. It powers two things:
#   - the "Add a character" form (also needs ADMIN_PASSCODE)
#   - the Changelog tab (history of level, item level, guild, HK and death changes)
# Vercel sets these two for you when you connect one; they may be named
# KV_REST_API_URL / KV_REST_API_TOKEN instead, which also works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The shared passcode friends type into the add form. Pick something long.
# The same passcode also allows removing a character that was added through the site.
ADMIN_PASSCODE=
# Optional: most characters allowed on the board (default 50)
MAX_CHARACTERS=50
# Optional: how many changelog events to keep (default 500)
CHANGELOG_MAX_EVENTS=500
